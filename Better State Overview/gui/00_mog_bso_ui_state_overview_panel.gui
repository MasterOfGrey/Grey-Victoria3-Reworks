		}																# BSO: STRUCTURED VIEW ENDS HERE
	}

	type state_panel_status_item_extra_small = container {	# BSO: new TYPE - split text for fancy tooltips
		flowcontainer = {
			spacing = 5
			margin = { 5 10 }

			background = {
				using = entry_bg_simple
			}

			block "icon" {
				icon = {
					block "texture" {}
					block "alpha" {}
					block "iconsize" {}		# default: size = { 71 71 }
					parentanchor = vcenter
				}
			}

			container = {
				block "defaultsize" {
					minimumsize = { -1 68.5 }	# Allow for adjusting internal icon heights
				}
				flowcontainer = {
					parentanchor = vcenter
					direction = vertical
					block "flow_margin" {}
					block "flow_spacing" {}
					textbox = {
						block "name" {}
						block "alpha" {}
						autoresize = yes
						block "maximumsize" {			# 85 is the clean 3-way split
							minimumsize = { 85 -1 }
							maximumsize = { 85 -1 }
						}
						multiline = yes
						align = nobaseline
					}
					textbox = {
						block "name2" {}
						autoresize = yes
						block "maximumsize" {			# 85 is the clean 3-way split
							minimumsize = { 85 -1 }
							maximumsize = { 85 -1 }
						}
						multiline = yes
						align = nobaseline
					}

					block "extra_widget" {

					}
				}
			}
		}

		block "navigation_button" {
			button_icon_goto = {
				position = { -2 2 }
				size = { 25 25 }
				block "goto" {
					visible = no
				}
				parentanchor = top|right
			}
		}
	}
}