			state_panel_status_item_extra_small = {						# BSO Tripanel NOT Split-State # FILLER
				datacontext = "[State.GetFoodSecurity]"
				visible = "[And4(Not(State.IsSplitState),
					Not(State.IsSlaveState),
					Not(State.IsTreatyPort),
					Not(Or8(
						And(And(GreaterThan_int64(FoodSecurity.GetNumStarvingPops, '(int64)500'), Not(State.HasFamine)), Not(GreaterThan_CFixedPoint(FoodSecurity.GetPercentageStarvingPopsSevere, '(CFixedPoint)0.02'))),
						And(GreaterThan_CFixedPoint(FoodSecurity.GetPercentageStarvingPopsSevere, '(CFixedPoint)0.02'), Not(State.HasFamine)),
						State.HasFamine,
						State.HasTurmoilEffects,
						GreaterThan_CFixedPoint(State.GetObstinance, '(CFixedPoint)0.01'),
						State.HasDevastation,
						GreaterThan_CFixedPoint(State.GetBlockadeLevel, '(CFixedPoint)0'),
						State.IsBeingBombarded) ) )]"
				onmousehierarchyenter = "[AccessHighlightManager.HighlightStateRegion(State.GetStateRegion)]"
				onmousehierarchyleave = "[AccessHighlightManager.RemoveHighlight]"
				alwaystransparent = no
		
				blockoverride "texture" {
					texture = "gfx/interface/icons/dlc_icons/dynamic_countries.dds"
				}
				blockoverride "iconsize" {
					size = { 52 52 }
				}
		
				blockoverride "name" {
					text = "STATE_REGION_STATE_STATUS"
				}
				blockoverride "maximumsize" {		# Should equal 85 + (71 - iconsize)
					minimumsize = { 104 -1 }
					maximumsize = { 104 -1 }
				}
			}
		}																# BSO: TRIPANEL ENDS HERE

		flowcontainer = {
			parentanchor = hcenter
			margin = { 10 10 }
			margin_top = 0
			spacing = 10
			wrap_count = 2
			ignoreinvisible = yes
			visible = "[GetScriptedGui('mog_bso_structured_state_panel_sgui').IsShown(GuiScope.End)]"
			
			state_panel_status_item_small = {				# REORDERED (unchanged)				# STATE TYPE START
				visible = "[State.IsCapitalState]"
